{
  // Configuration for the Cloudflare Worker that serves this Next.js app.
  // The build output referenced below is produced by `opennextjs-cloudflare build`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "diana-wedding",
  "compatibility_date": "2026-10-01",
  // Workers Cache is intentionally DISABLED (it was `"cache": { "enabled": true }`).
  //
  // It let Cloudflare's edge answer eligible GET/HEAD requests without invoking
  // the Worker, but Next/OpenNext also send
  // `Cache-Control: s-maxage=<revalidate>, stale-while-revalidate=...` for
  // SSG/ISR pages, so the edge kept the old HTML for the whole ISR window.
  // On workers.dev that copy cannot be purged — the adapter's `Cache-Tag`
  // purge needs a zone (`isPurgeCacheEnabled`) — which meant a Sanity edit
  // stayed invisible for up to 30 minutes even after the tag cache was
  // invalidated. Cache hits are still cheap without it: `enableCacheInterception`
  // serves them from the KV entry without booting the Next.js bundle.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    // Everything in `public/` plus the Next.js static chunks, served directly
    // by the asset server. See `public/_headers` for their cache headers.
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker
      // name. Used by the incremental cache.
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "diana-wedding"
    }
  ],
  "kv_namespaces": [
    // ISR cache (free). Create once in the dashboard:
    // Storage & databases → KV → Create namespace, then paste its ID below.
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "8c05337262664c7f9693a7ad77174b8d"
    }
  ],
  "vars": {
    // ISR revalidation (Durable Object queue). A Sanity query can take up to
    // 3 × 5s (client `timeout` × `maxRetries`) before it gives up, so allow
    // 30s per revalidation attempt instead of the adapter's 10s default —
    // otherwise a slow Content Lake response aborts the re-render again.
    "NEXT_CACHE_DO_QUEUE_REVALIDATION_TIMEOUT_MS": "30000"
  },
  "durable_objects": {
    "bindings": [
      // ISR revalidation queue (see open-next.config.ts). The class is exported
      // by the adapter's worker entry (`.open-next/worker.js`), so it only has
      // to be bound here. On the free plan Durable Objects with SQLite storage
      // are included, which is what the queue uses for its dedupe/retry state.
      //
      // NOTE: `next dev` reads `wrangler.dev.jsonc` instead of this file (see
      // next.config.mjs) — a Durable Object binding cannot work there because
      // the dev platform runs Miniflare with an empty worker script. Keep the
      // non-DO parts of the two files in sync.
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      // Cache tags written by `revalidateTag()` / `revalidatePath()` (see
      // open-next.config.ts). A tag is stored in one shard; reads and writes go
      // straight to the Durable Object, so a Sanity webhook takes effect
      // immediately instead of after the KV tag cache's ~60s propagation.
      // Like the queue, the class is exported by the adapter's worker entry, so
      // binding it here is enough.
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      // Applied automatically by the next `wrangler deploy` (OpenNext's deploy
      // command runs it). Existing v1 objects are untouched; this only adds the
      // tag cache class.
      "tag": "v2",
      "new_sqlite_classes": ["DOShardedTagCache"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
    // No `images` binding on purpose: this site never uses `next/image`, every
    // photo is a plain <img> pointing at the Sanity CDN.
  }
}