{
  // Configuration for the Cloudflare Worker that serves this Next.js app.
  // The build output referenced below is produced by `opennextjs-cloudflare build`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "diana-wedding",
  "compatibility_date": "2026-10-01",
  // Workers Cache: eligible GET/HEAD responses are served from Cloudflare's
  // edge WITHOUT invoking the Worker (zero CPU on hits). Next/OpenNext emit
  // `s-maxage=<revalidate>` for SSG/ISR pages, which defines the edge TTL.
  // Revert by deleting this block if ISR revalidation ever stalls.
  "cache": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    // Everything in `public/` plus the Next.js static chunks, served directly
    // by the asset server. See `public/_headers` for their cache headers.
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker
      // name. Used by the incremental cache.
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "diana-wedding"
    }
  ],
  "kv_namespaces": [
    // ISR cache (free). Create once in the dashboard:
    // Storage & databases → KV → Create namespace, then paste its ID below.
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "8c05337262664c7f9693a7ad77174b8d"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
    // No `images` binding on purpose: this site never uses `next/image`, every
    // photo is a plain <img> pointing at the Sanity CDN.
  }
}